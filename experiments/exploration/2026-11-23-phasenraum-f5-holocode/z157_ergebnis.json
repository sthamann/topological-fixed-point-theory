 "praemissen_z151": [
  [
   "P_Omega",
   "entfällt als Wahl der Polstruktur: Auf E_i ist das holomorphe Differential bis auf Normierung eindeutig (Geschlecht 1); ersetzt durch P_wurzel"
  ],
  [
   "P_red",
   "entfällt: keine Wahl der Nullstellen der Reduktion; ersetzt durch P_wurzel (omega = Wurzel aus Phi_M auf der Doppelüberlagerung; aus der Twistorreduktion folgt das nicht, D2)"
  ],
  [
   "P_rand",
   "entfällt: keine Pole, keine Randbedingung [L]; an ihre Stelle tritt das starre, mit der Kleinschen Vierergruppe verdrillte Bündel (P_buendel; die Vierergruppe Gamma_x, Gamma_y, Gamma_z ist im Bestand nativ)"
  ],
  [
   "P_spek",
   "bleibt: Die Spektralkurve der Kette (Dispersionskurve, j = 1728 exakt) ist die Doppelüberlagerung der Markensphäre; die Koordinate s = i sin q wird mit der nativen Koordinate z gleichgesetzt"
  ],
  [
   "P_GS",
   "gegenstandslos: Für die elliptische Klasse gibt es keine Herkunft aus dem Twistorraum (D2); die 4D-Chern-Simons-Theorie selbst braucht das Zusatzfeld nicht [L]"
  ]
 ],
 "praemissen_neu": [
  [
   "P_wurzel",
   "Die Einsform der Spektralkurve ist die Wurzel dz/w des nativen quadratischen Differentials Phi_M; die Spektralkurve ist die Doppelüberlagerung E_i der Markensphäre (ersetzt P_Omega und P_red)"
  ],
  [
   "P_buendel",
   "Eichbündel = das starre sl(2)-Bündel mit Holonomien sigma_x, sigma_z (ersetzt P_rand)"
  ],
  [
   "P_aut",
   "Der Abstand der zwei Linienscharen ist ein Bild des Kreuzungsparameters unter Aut(E_i) (u = i lam); auf der Nahtkette gleich P_fr aus z151 (zweite Schar = Uhrbild der ersten). Ersetzt P_viertel"
  ],
